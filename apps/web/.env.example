# Copy to .env.local. Browser-visible values only; never put keys here.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
# Set to 1 to run with in-browser mock data and a mock wallet (no API or chain needed).
NEXT_PUBLIC_MOCK=0
NEXT_PUBLIC_BOUNTY_CONTRACT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
# Optional block explorer base URL, e.g. https://testnet.arcscan.app. Leave empty on Anvil.
NEXT_PUBLIC_EXPLORER_URL=
