# Local Anvil / testnet only. `corepack pnpm demo` writes a complete .env.local for you.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
BOUNTY_CONTRACT_ADDRESS=
USDC_ADDRESS=

# Runner process (packages/runner). The only place receipt signing keys live.
RUNNER_SIGNER_PRIVATE_KEY=
# Optional separate key for SecurityReview receipts (REVIEWER_ROLE); defaults to the runner key.
REVIEWER_SIGNER_PRIVATE_KEY=
# docker (default) or process. process is UNSANDBOXED: local demos with trusted code only.
RUNNER_BACKEND=docker
RUNNER_PORT=4100
# Where per-run snapshots are staged; must be shared with the Docker VM. Defaults to ~/.abm/sandbox.
ABM_SANDBOX_DIR=
# Optional module whose default export implements SecurityReviewer (packages/runner/src/security.ts).
SECURITY_REVIEWER_MODULE=

# API (apps/api)
API_PORT=4000
API_DB_PATH=
RUNNER_URL=http://127.0.0.1:4100
RUNNER_SIGNER_ADDRESSES=
# Pays gas to relay submitCode/submitReceipt. Holds no role and cannot move funds.
RELAYER_PRIVATE_KEY=
# Set to 0 to disable starting runs automatically on submit.
AUTO_RUN=1
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed script only (apps/api seed:onchain): funds demo bounties as the creator.
CREATOR_PRIVATE_KEY=

# MCP stdio server (packages/mcp); defaults to http://127.0.0.1:$API_PORT
ABM_API_URL=
